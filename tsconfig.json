// Repository tooling: the checks and generators under scripts/ and turbo/.
// Nothing here ships; these are programs tsx runs in place. `.ts` imports are
// allowed because eslint-plugin and the generators reach into package source.
{
  "extends": "@lvbt/typescript-config/node.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": ["scripts", "turbo"]
}
