{
  "name": "transitmapper",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://map.lasvegasfortransit.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LasVegasForTransit/transit-mapper.git"
  },
  "bugs": {
    "url": "https://github.com/LasVegasForTransit/transit-mapper/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.20.0"
  },
  "scripts": {
    "bootstrap": "lvbt bootstrap",
    "preflight": "lvbt preflight",
    "provision": "tsx scripts/bootstrap/cold-start.ts",
    "doctor": "tsx scripts/bootstrap/cold-start.ts --doctor",
    "build": "turbo run build",
    "build:release": "tsx apps/web/scripts/run-build.ts",
    "dev": "turbo run dev",
    "preview": "turbo run preview",
    "worker:dev": "pnpm --filter @transitmapper/worker dev",
    "perf": "pnpm --filter @transitmapper/web perf",
    "perf:record": "pnpm --filter @transitmapper/web perf:record",
    "perf:soak": "pnpm --filter @transitmapper/web perf:soak",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "validate": "pnpm check:root && pnpm check:config && pnpm check:migrations && pnpm check:structure && pnpm check:breakpoint && pnpm check:deadcode && pnpm check:duplication && pnpm check:boundaries && pnpm check:documents && pnpm check:reference",
    "check:root": "eslint scripts turbo --max-warnings 0 && tsc -b tsconfig.json --noEmit",
    "check:migrations": "tsx scripts/check-migrations-append-only.ts",
    "check:structure": "tsx scripts/check-project-structure.ts",
    "check:breakpoint": "tsx scripts/check-breakpoint.ts",
    "check:config": "tsx scripts/check-config.ts",
    "check:deadcode": "knip --max-issues 0",
    "check:duplication": "jscpd --config jscpd.config.json",
    "check:boundaries": "depcruise --config dependency-cruiser.config.mjs apps packages",
    "check:documents": "tsx scripts/check-document-standards.ts",
    "check:reference": "tsx scripts/generate-checks-reference.ts --check",
    "check:generators": "tsx scripts/check-generators.ts",
    "check:env": "tsx scripts/doctor.ts",
    "gen": "turbo gen",
    "gen:checks": "tsx scripts/generate-checks-reference.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && markdownlint-cli2 && lvbt check && turbo run lint check-types test validate",
    "check:fix": "pnpm format && markdownlint-cli2 --fix && turbo run lint -- --fix",
    "postinstall": "tsx scripts/record-install.ts",
    "prepare": "git config --local core.hooksPath .githooks",
    "deploy": "lvbt deploy"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@lvbt/cli": "github:LasVegasForTransit/repository-tooling#v0.2.1&path:/packages/cli",
    "@lvbt/eslint-config": "github:LasVegasForTransit/repository-tooling#v0.2.1&path:/packages/eslint-config",
    "@lvbt/prettier-config": "github:LasVegasForTransit/repository-tooling#v0.2.1&path:/packages/prettier-config",
    "@lvbt/typescript-config": "github:LasVegasForTransit/repository-tooling#v0.2.1&path:/packages/typescript-config",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-relative-links": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
