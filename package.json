{
  "name": "transitmapper",
  "version": "0.7.3",
  "private": true,
  "license": "MIT",
  "homepage": "https://map.lasvegasfortransit.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LasVegasForTransit/transit-mapper.git"
  },
  "bugs": {
    "url": "https://github.com/LasVegasForTransit/transit-mapper/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @transitmapper/web dev",
    "preview": "pnpm --filter @transitmapper/web preview",
    "perf": "pnpm --filter @transitmapper/web perf",
    "perf:record": "pnpm --filter @transitmapper/web perf:record",
    "perf:freeze-497a549": "pnpm --filter @transitmapper/web perf:freeze-497a549",
    "perf:soak": "pnpm --filter @transitmapper/web perf:soak",
    "renderer:capture": "pnpm --filter @transitmapper/web renderer:capture",
    "worker:dev": "pnpm --filter @transitmapper/worker dev",
    "build": "tsx apps/web/scripts/run-build.ts",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm verify:root && turbo run verify",
    "deploy": "pnpm run build && pnpm --filter @transitmapper/worker run deploy",
    "bootstrap": "tsx scripts/bootstrap/cold-start.ts",
    "refresh:gtfs": "tsx scripts/refresh-gtfs-feeds.ts",
    "provision:gtfs-storage": "tsx scripts/provision-gtfs-storage.ts",
    "preflight": "tsx scripts/bootstrap/cold-start.ts --doctor",
    "postinstall": "tsx scripts/record-install.ts",
    "prepare": "git config --local core.hooksPath .githooks 2>/dev/null || true",
    "lint": "turbo run lint:workspace",
    "lint:root": "eslint eslint.config.ts scripts ./turbo",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contract": "tsx scripts/check-workspace-contract.ts",
    "check:filenames": "tsx scripts/check-file-names.ts",
    "check": "tsx scripts/run-checks.ts",
    "check:fix": "pnpm check --fix",
    "check:docs": "tsx scripts/check-docs-links.ts",
    "check:migrations": "tsx scripts/check-migrations-append-only.ts",
    "check:structure": "tsx scripts/check-project-structure.ts",
    "check:breakpoint": "tsx scripts/check-breakpoint.ts",
    "check:config": "tsx scripts/check-config.ts",
    "check:debt": "tsx scripts/check-debt.ts",
    "check:deadcode": "knip --max-issues 0",
    "check:duplication": "jscpd --config jscpd.config.json",
    "check:boundaries": "depcruise --config dependency-cruiser.config.mjs apps packages",
    "gen": "turbo gen",
    "check:generators": "tsx scripts/check-generators.ts",
    "check:env": "tsx scripts/doctor.ts",
    "gen:checks": "tsx scripts/generate-checks-reference.ts",
    "check:reference": "tsx scripts/generate-checks-reference.ts --check",
    "check:documents": "tsx scripts/check-document-standards.ts",
    "check:repository-tooling": "tsx scripts/check-repository-tooling.ts",
    "typecheck:root": "tsc -b tsconfig.json --noEmit",
    "verify:root": "vitest run scripts/tests --maxWorkers=1"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@transitmapper/config-eslint": "workspace:*",
    "@transitmapper/eslint-plugin": "workspace:*",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "fflate": "catalog:",
    "jiti": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
