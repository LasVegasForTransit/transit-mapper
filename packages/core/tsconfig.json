// Every TypeScript file in this package, which is what the name has to mean.
//
// TypeScript's language service — the thing an editor and `projectService`
// both use — resolves a file by walking up to the nearest `tsconfig.json` and
// nothing else. A file this config leaves out therefore has no types anywhere
// outside a `tsc` run: no editor errors, and type-aware lint rejects it
// outright. So this is the wide one, and `tsconfig.build.json` is where the
// production scope is narrowed.
{
  "extends": "./tsconfig.build.json",
  "include": ["src", "tests", "vitest.config.ts"]
}
