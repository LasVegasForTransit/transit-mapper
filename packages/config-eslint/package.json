{
  "name": "@transitmapper/config-eslint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json --noEmit && tsc -b tsconfig.json --noEmit",
    "lint": "eslint .",
    "verify": "vitest run"
  },
  "devDependencies": {
    "@transitmapper/tsconfig": "workspace:*",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@eslint/js": "catalog:",
    "eslint-config-prettier": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:"
  }
}
