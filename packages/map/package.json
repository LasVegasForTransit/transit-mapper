{
  "name": "@transitmapper/map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./state": {
      "development": {
        "types": "./src/state.ts",
        "import": "./src/state.ts"
      },
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "verify": "vitest run"
  },
  "devDependencies": {
    "@transitmapper/tsconfig": "workspace:*",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@transitmapper/views": "workspace:*",
    "maplibre-gl": "catalog:"
  }
}
