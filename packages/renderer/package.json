{
  "name": "@transitmapper/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./camera": {
      "development": {
        "types": "./src/camera-render-preload.ts",
        "import": "./src/camera-render-preload.ts"
      },
      "types": "./dist/camera-render-preload.d.ts",
      "import": "./dist/camera-render-preload.js"
    },
    "./layers": {
      "development": {
        "types": "./src/layers.ts",
        "import": "./src/layers.ts"
      },
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./line": {
      "development": {
        "types": "./src/line.ts",
        "import": "./src/line.ts"
      },
      "types": "./dist/line.d.ts",
      "import": "./dist/line.js"
    },
    "./network": {
      "development": {
        "types": "./src/network.ts",
        "import": "./src/network.ts"
      },
      "types": "./dist/network.d.ts",
      "import": "./dist/network.js"
    },
    "./presentation": {
      "development": {
        "types": "./src/render-presentation.ts",
        "import": "./src/render-presentation.ts"
      },
      "types": "./dist/render-presentation.d.ts",
      "import": "./dist/render-presentation.js"
    },
    "./projection": {
      "development": {
        "types": "./src/projection.ts",
        "import": "./src/projection.ts"
      },
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js"
    },
    "./projection-worker": {
      "development": {
        "types": "./src/workers/feature-projection-worker.ts",
        "import": "./src/workers/feature-projection-worker.ts"
      },
      "types": "./dist/workers/feature-projection-worker.d.ts",
      "import": "./dist/workers/feature-projection-worker.js"
    },
    "./runtime": {
      "development": {
        "types": "./src/runtime.ts",
        "import": "./src/runtime.ts"
      },
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./stats": {
      "development": {
        "types": "./src/stats.ts",
        "import": "./src/stats.ts"
      },
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@lvbt/typescript-config": "catalog:",
    "@lvbt/vitest-config": "catalog:",
    "@types/geojson": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@transitmapper/core": "workspace:*"
  }
}
