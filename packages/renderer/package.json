{
  "name": "@transitmapper/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./driver": {
      "development": {
        "types": "./src/driver.ts",
        "import": "./src/driver.ts"
      },
      "types": "./dist/driver.d.ts",
      "import": "./dist/driver.js"
    },
    "./feature-details": {
      "development": {
        "types": "./src/document-map-feature-details.ts",
        "import": "./src/document-map-feature-details.ts"
      },
      "types": "./dist/document-map-feature-details.d.ts",
      "import": "./dist/document-map-feature-details.js"
    },
    "./layers": {
      "development": {
        "types": "./src/layers.ts",
        "import": "./src/layers.ts"
      },
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./projection": {
      "development": {
        "types": "./src/projection.ts",
        "import": "./src/projection.ts"
      },
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js"
    },
    "./presentation": {
      "development": {
        "types": "./src/presentation.ts",
        "import": "./src/presentation.ts"
      },
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./runtime": {
      "development": {
        "types": "./src/runtime.ts",
        "import": "./src/runtime.ts"
      },
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./stats": {
      "development": {
        "types": "./src/stats.ts",
        "import": "./src/stats.ts"
      },
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "verify": "vitest run"
  },
  "devDependencies": {
    "@transitmapper/tsconfig": "workspace:*",
    "@types/geojson": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@transitmapper/core": "workspace:*",
    "@transitmapper/map": "workspace:*",
    "@transitmapper/views": "workspace:*",
    "maplibre-gl": "catalog:"
  }
}
