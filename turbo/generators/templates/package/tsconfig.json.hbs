// Every TypeScript file in this package. TypeScript's language service resolves
// a file by walking up to the nearest `tsconfig.json` and only that name, so
// anything left out here has no types in an editor and is rejected outright by
// type-aware lint rather than checked.
{
  "extends": "./tsconfig.build.json",
  "include": ["src", "tests", "vitest.config.ts"]
}
