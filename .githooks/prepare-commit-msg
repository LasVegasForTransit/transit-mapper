#!/usr/bin/env sh
# Adds an attribution footer when a coding agent is driving the commit.
#
# The rule it serves is in docs/development/reference/commit-messages.md: a
# commit written with help from an agent says so. Presence cannot be checked
# after the fact — no hook can look at a diff and tell who wrote it — so this
# writes it at the one moment the information exists, which is while the agent
# is still the thing running git.
#
# It is a floor, not the whole rule. An agent that names its own model writes a
# better footer than this can: the environment says which TOOL is running but
# never which MODEL, so `ANTHROPIC_MODEL` is empty even under Claude Code.
# This never overwrites a footer that is already there, so a precise
# `Co-Authored-By: Claude Opus 5 <…>` survives and only a missing one gets the
# tool-level fallback.
set -e
MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Nothing to attribute for messages git composes itself. `squash` covers the
# rebase/fixup path, where the footers already belong to the commits being
# combined.
case "$COMMIT_SOURCE" in
  merge | squash) exit 0 ;;
esac

# Which agent, if any. AI_AGENT is the cross-vendor spelling and carries a
# version; CLAUDECODE is Claude Code's own boolean. Neither says which model,
# which is why the footer below names the tool.
if [ -n "${AI_AGENT:-}" ]; then
  AUTHOR='Claude Code <noreply@anthropic.com>'
elif [ "${CLAUDECODE:-}" = "1" ]; then
  AUTHOR='Claude Code <noreply@anthropic.com>'
else
  exit 0
fi

# Already attributed — by the agent itself, or by an earlier run of this hook
# on the commit being amended. Adding a second line would credit the same work
# twice, and `git commit --amend` re-runs this hook every time.
if grep -qi '^Co-Authored-By:' "$MSG_FILE"; then
  exit 0
fi

# An empty message means the commit is about to be aborted anyway; writing a
# footer into it would turn that abort into a commit with no subject.
if ! grep -qv -e '^#' -e '^[[:space:]]*$' "$MSG_FILE"; then
  exit 0
fi

# Append inside the existing footer block when there is one, so a
# `BREAKING CHANGE:` footer keeps its new neighbour rather than being split
# into a paragraph of its own — which is what `git interpret-trailers` does
# here, because the space in that token is not a valid trailer key.
#
# Comments are left where they are: git strips them itself, and moving them
# would change what the editor shows.
awk -v footer="Co-Authored-By: $AUTHOR" '
  { lines[NR] = $0 }
  END {
    # The last line of real content, ignoring git`s comment block and any
    # trailing blank lines.
    last = 0
    for (i = 1; i <= NR; i++) {
      if (lines[i] !~ /^#/ && lines[i] !~ /^[[:space:]]*$/) last = i
    }
    # Where the paragraph containing that line starts.
    start = 1
    for (i = last; i >= 1; i--) {
      if (lines[i] ~ /^[[:space:]]*$/) { start = i + 1; break }
    }
    # Is that paragraph made only of footers? If so the new one joins it; if
    # not, it needs a blank line to become a footer block of its own.
    joinable = (last > 0)
    for (i = start; i <= last; i++) {
      if (lines[i] !~ /^[A-Za-z][A-Za-z-]*: / &&
          lines[i] !~ /^BREAKING[ -]CHANGE: / &&
          lines[i] !~ /^[[:space:]]+[^[:space:]]/) { joinable = 0; break }
    }
    for (i = 1; i <= NR; i++) {
      if (i == last + 1) {
        if (!joinable) print ""
        print footer
      }
      print lines[i]
    }
    if (last == NR) {
      if (!joinable) print ""
      print footer
    }
  }
' "$MSG_FILE" >"$MSG_FILE.tmp"
mv "$MSG_FILE.tmp" "$MSG_FILE"
