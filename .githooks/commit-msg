#!/usr/bin/env sh
# Validates the subject line against the standard in
# docs/development/reference/commit-messages.md.
#
# The rules live in that document, not in this script. This only enforces
# the two that a machine can check without judgement.
set -e
MSG_FILE="$1"
SUBJECT=$(head -1 "$MSG_FILE")

# git writes these itself; they are not authored messages.
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

if ! printf '%s' "$SUBJECT" | grep -qE '^[a-z]+(\([a-z0-9._/-]+\))?!?: .+'; then
  printf '\n  Commit blocked: the subject is not a conventional commit.\n\n' >&2
  printf '    got:       %s\n' "$SUBJECT" >&2
  printf '    expected:  type(optional-scope): description\n' >&2
  printf '    example:   feat: add pnpm preflight\n\n' >&2
  printf '    see:  docs/development/reference/commit-messages.md\n\n' >&2
  exit 1
fi

LENGTH=$(printf '%s' "$SUBJECT" | wc -c | tr -d ' ')
if [ "$LENGTH" -gt 72 ]; then
  printf '\n  Commit blocked: the subject is %s characters; the limit is 72.\n\n' "$LENGTH" >&2
  printf '    %s\n\n' "$SUBJECT" >&2
  printf '    Put the detail in the body. The subject names the change;\n' >&2
  printf '    the body explains why it was made.\n\n' >&2
  printf '    see:  docs/development/reference/commit-messages.md\n\n' >&2
  exit 1
fi

# Attribution trailers, when the message has any.
#
# Whether an agent helped write a commit is not something this script can
# determine, so it cannot require the trailer — that rule is carried by
# whoever writes the message. What it can check is the shape, and that is
# worth checking: a malformed Co-Authored-By looks like attribution and does
# not parse as one, so `git log --format='%(trailers:key=Co-Authored-By)'`
# reports nothing and the credit is silently lost.
# Strip comments the way git does before it stores the message, so the
# scissors line and everything under it does not count as the last paragraph.
BODY=$(grep -v '^#' "$MSG_FILE")
WRITTEN=$(printf '%s\n' "$BODY" | grep -ci '^Co-Authored-By:' || true)

if [ "$WRITTEN" -gt 0 ]; then
  # Placement, checked against the last blank-line-separated paragraph rather
  # than against `git interpret-trailers --parse`. That command refuses to see
  # a trailer block at all when it contains `BREAKING CHANGE:` — the space in
  # that token is not a valid trailer key — and this repo's own convention
  # puts exactly that footer beside attribution.
  # A footer block is the last paragraph AND contains nothing but footers.
  # Both halves matter: "in the last paragraph" alone accepts a trailer with
  # prose under it, which is the most common way to get this wrong.
  IN_FOOTER=$(printf '%s\n' "$BODY" | awk '
    { lines[NR] = $0 }
    END {
      # Ignore trailing blank lines, then walk back to the blank line that
      # opens the last paragraph.
      last = NR
      while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
      start = 1
      for (i = last; i >= 1; i--) {
        if (lines[i] ~ /^[[:space:]]*$/) { start = i + 1; break }
      }
      for (i = start; i <= last; i++) {
        # A footer is `Key: value`, `BREAKING CHANGE: value`, or a continuation
        # line indented under one. Anything else means this paragraph is prose.
        if (lines[i] !~ /^[A-Za-z][A-Za-z-]*: / &&
            lines[i] !~ /^BREAKING[ -]CHANGE: / &&
            lines[i] !~ /^[[:space:]]+[^[:space:]]/) { print 0; exit }
      }
      for (i = start; i <= last; i++) if (tolower(lines[i]) ~ /^co-authored-by:/) n++
      print n + 0
    }')
  if [ "$WRITTEN" != "$IN_FOOTER" ]; then
    printf '\n  Commit blocked: an attribution trailer is not in the footer.\n\n' >&2
    printf '    Co-Authored-By lines in the message:  %s\n' "$WRITTEN" >&2
    printf '    Co-Authored-By lines in the footer:   %s\n\n' "$IN_FOOTER" >&2
    printf '    It has to sit in the last block of the message, separated from\n' >&2
    printf '    the body by a blank line, with nothing but other footers beside\n' >&2
    printf '    it. Prose under it makes that block body, and git stops reading\n' >&2
    printf '    any of it as attribution.\n\n' >&2
    printf '    see:  docs/development/reference/commit-messages.md\n\n' >&2
    exit 1
  fi

  # Well-placed is not the same as usable: `Co-Authored-By: Claude Opus 5`
  # with no address credits nobody git can identify.
  MALFORMED=$(printf '%s\n' "$BODY" | grep -i '^Co-Authored-By:' |
    grep -vE '^[Cc]o-[Aa]uthored-[Bb]y: .+ <[^ ]+@[^ ]+>$' || true)
  if [ -n "$MALFORMED" ]; then
    printf '\n  Commit blocked: an attribution trailer has no usable address.\n\n' >&2
    printf '%s\n' "$MALFORMED" | while IFS= read -r line; do printf '    %s\n' "$line" >&2; done
    printf '\n    Write it as:\n\n' >&2
    printf '      Co-Authored-By: Name <email>\n\n' >&2
    printf '    see:  docs/development/reference/commit-messages.md\n\n' >&2
    exit 1
  fi
fi
