{
  "extends": "@transitmapper/tsconfig/base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  // Browser sources only. The test suite in `scripts/` is a Node program and
  // is typechecked by tsconfig.scripts.json instead — see that file for why
  // the two can't share one config, and why it isn't simply left out.
  "include": ["src"]
}
