{
  "extends": "@transitmapper/tsconfig/base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  // Browser sources only. Node tooling and tests are typechecked separately by
  // tsconfig.scripts.json so Node globals do not enter the production config.
  "include": ["src"]
}
