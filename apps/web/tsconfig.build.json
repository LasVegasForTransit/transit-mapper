// Browser sources only, and the authority on what ships to a browser.
//
// Node's globals are deliberately absent here. `tsconfig.json` beside this one
// admits them, because the tests and build tooling are Node programs, and it
// has to cover them for the language service to resolve them at all. That
// makes this the file that decides what `src` may reference: a source file
// that reaches for `process` compiles under the wide config and fails here.
{
  "extends": "@transitmapper/tsconfig/base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
