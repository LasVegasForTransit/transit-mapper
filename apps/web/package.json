{
  "name": "@transitmapper/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build && tsx scripts/perf/report-bundle.ts && tsx scripts/perf/verify-pwa-output.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -b tsconfig.build.json --noEmit && tsc -b tsconfig.json --noEmit",
    "test": "tsx tests/verify.test.ts && vitest run",
    "generate:icons": "tsx scripts/generate-app-icons.ts",
    "check:icons": "tsx scripts/generate-app-icons.ts --check",
    "perf": "tsx scripts/perf/run.ts",
    "perf:record": "tsx scripts/perf/run.ts --record",
    "perf:soak": "tsx scripts/perf/run.ts --soak",
    "validate": "pnpm check:icons"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-popover": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@transitmapper/core": "workspace:*",
    "@transitmapper/pwa-updater": "workspace:*",
    "lucide-react": "catalog:",
    "maplibre-gl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@lvbt/eslint-config": "github:LasVegasForTransit/repository-tooling#v0.2.2&path:/packages/eslint-config",
    "@lvbt/typescript-config": "github:LasVegasForTransit/repository-tooling#v0.2.2&path:/packages/typescript-config",
    "@lvbt/vitest-config": "github:LasVegasForTransit/repository-tooling#v0.2.2&path:/packages/vitest-config",
    "@types/geojson": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "playwright-core": "catalog:",
    "sharp": "catalog:",
    "terser": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:",
    "workbox-window": "catalog:"
  }
}
