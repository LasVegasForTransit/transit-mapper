{
  "name": "@transitmapper/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build && tsx scripts/perf/report-bundle.ts && tsx scripts/perf/verify-pwa-output.ts",
    "generate:icons": "tsx scripts/generate-app-icons.ts",
    "check:icons": "tsx scripts/generate-app-icons.ts --check",
    "preview": "vite preview",
    "perf": "tsx scripts/perf/run.ts",
    "perf:record": "tsx scripts/perf/run.ts --record",
    "perf:freeze-497a549": "tsx scripts/perf/freeze-497a549-baseline.ts",
    "perf:soak": "tsx scripts/perf/run.ts --soak",
    "renderer:capture": "tsx scripts/renderer-capture/run.ts",
    "typecheck": "tsc -b tsconfig.build.json --noEmit && tsc -b tsconfig.json --noEmit",
    "verify": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "@transitmapper/core": "workspace:*",
    "@transitmapper/pwa-updater": "workspace:*",
    "lucide-react": "catalog:",
    "maplibre-gl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@transitmapper/tsconfig": "workspace:*",
    "@types/geojson": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "playwright-core": "catalog:",
    "sharp": "catalog:",
    "terser": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:"
  }
}
