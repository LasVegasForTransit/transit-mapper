// Typechecks Node-run tooling, the sequential suite, the asset verifier, and
// Vitest files without admitting Node globals into the production browser
// config. `vite/client` stays alongside `node` because the tests and tools
// import browser sources that use `import.meta.env`.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["scripts", "tests"]
}
