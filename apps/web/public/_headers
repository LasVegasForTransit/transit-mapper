# Response headers for assets served straight from Cloudflare, without the
# Worker running. That is now most of the site — the Worker is scoped to
# /api/*, /s/*, /v/*, /e/* and /embed/* (see run_worker_first in
# apps/worker/wrangler.toml) — so the editor's own HTML, JS and CSS never pass
# through Worker code and can't be given headers there. This file is the only
# place to set them.
#
# Worker-generated responses ignore this file entirely; those set their own
# headers in apps/worker/src/index.ts.
#
# A build for anything other than the production origin gets one more header
# inserted into the /* block below — `X-Robots-Tag: noindex`, added by
# scripts/deployment/crawl-directives.ts. So a pull request preview serves
# different bytes here than the file you are reading. That is the only
# difference, and it is what keeps previews out of search results.

/*
  # The editor is an application surface, not something to be framed. The one
  # deliberate exception is /e/:id, which the Worker serves with its own
  # frame-ancestors and never reaches this file.
  Content-Security-Policy: frame-ancestors 'none'
  # Stop a browser second-guessing our content types.
  X-Content-Type-Options: nosniff
  # Send the origin to third parties, never the full path — a share id should
  # not leak into another site's referer logs.
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here needs a camera, a microphone or someone's location.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Two years, subdomains included. Only meaningful over HTTPS, which is the
  # only way this origin is served.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Vite fingerprints these filenames, so a given URL's bytes never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Font glyph ranges are versioned by directory and fetched on demand by
# MapLibre. They deliberately stay out of the service-worker precache.
/glyphs/noto-sans-v1/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker script itself — fixed filename, so it must always be
# revalidated. Browsers already re-check a SW at most every 24h regardless of
# headers, but there's no reason to let an edge cache add its own staleness on
# top of that: the whole point of this file existing is prompt update
# detection (see src/pwa/useAppUpdate.ts), so the one file the browser polls
# to notice a new version must never itself get stuck stale.
/sw.js
  Cache-Control: no-cache

# vite-plugin-pwa's Workbox runtime — content-hashed like /assets/*, so it's
# just as safe to cache forever; only sw.js's own fixed name needs no-cache.
/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable
