{
  "name": "@transitmapper/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.scripts.json",
    "verify": "tsx scripts/verify.ts && vitest run",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "types": "wrangler types",
    "check:types": "tsx scripts/check-generated-types.ts"
  },
  "dependencies": {
    "@transitmapper/core": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "tsx": "catalog:",
    "wrangler": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "vitest": "catalog:"
  }
}
