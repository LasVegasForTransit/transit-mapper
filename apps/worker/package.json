{
  "name": "@transitmapper/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build:cloudflare": "cf build",
    "check-types": "tsc -b tsconfig.build.json --noEmit && tsc -b tsconfig.json --noEmit",
    "test": "node --conditions=development --import tsx tests/verify.test.ts && vitest run",
    "deploy": "pnpm --dir ../.. run deploy",
    "lint": "eslint .",
    "types": "wrangler types",
    "check:types": "tsx scripts/check-generated-types.ts"
  },
  "dependencies": {
    "@transitmapper/core": "workspace:*",
    "@transitmapper/views": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@lasvegasfortransit/typescript-config": "file:../../.lvbt/web-platform/packages/typescript-config",
    "@lasvegasfortransit/vitest-config": "file:../../.lvbt/web-platform/packages/vitest-config",
    "@transitmapper/eslint-plugin": "workspace:*",
    "cf": "catalog:",
    "eslint": "catalog:",
    "smol-toml": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
