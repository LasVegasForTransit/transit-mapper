{
  "extends": "@transitmapper/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    // vitest-pool-workers/types declares the `cloudflare:test` module the
    // workerd tests import.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "src",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["tests/verify.test.ts"]
}
