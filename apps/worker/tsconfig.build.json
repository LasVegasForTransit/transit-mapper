// Workers-runtime sources only, and the authority on what deploys.
//
// Node's globals are deliberately absent. `tsconfig.json` beside this one
// admits them, because the Node-run verifier and the tooling under scripts/
// have to be covered by the config the language service actually reads. That
// makes this the file that decides what `src` may reference: a Worker source
// reaching for something only Node provides compiles under the wide config and
// fails here.
{
  "extends": "@lvbt/typescript-config/worker.json",
  "compilerOptions": {
    // Adoption debt against the organization base: the two flags below are on
    // in @lvbt/typescript-config and off here until this package's code is
    // made to pass them (about a thousand findings across the workspace when
    // the standard arrived). Turn one on, fix what it reports, and delete the
    // line; never add a new package with them off.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "worker-configuration.d.ts"]
}
