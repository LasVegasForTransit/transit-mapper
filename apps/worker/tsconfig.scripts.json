// Typechecks Node-run Worker tooling and the sequential verifier.
//
// Separate from tsconfig.json for the same reason apps/web splits its own:
// `src` is Workers-runtime code typed against @cloudflare/workers-types, and
// the suite is a Node program. Pulling Node's globals into `src` would let a
// Worker source file reference something the Workers runtime doesn't have and
// still compile — the opposite of what the main config is for.
//
// Both type sets are listed here because the suite imports from `src`, so it
// has to understand the Workers types the imported module is written against.
// (`types` replaces rather than extends the base array, so omitting either
// one breaks the half of the program that needs it.)
//
// `include` names only Node-run tooling and the verifier: verify.test.ts imports `../src/index`, so
// TypeScript pulls the Worker sources into the program anyway. Listing `src`
// as well only compiled it a second time — and made this config, where Node's
// globals are visible, look like the authority on `src`. `tsconfig.json` is;
// it runs first in the same `&&` chain.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": ["scripts", "tests/verify.test.ts"],
  // The Worker-runtime config excludes this Node-run verifier. Reset that
  // inherited exclusion so this program actually typechecks the listed file.
  "exclude": []
}
