{
  "name": "@lasvegasfortransit/web-platform",
  "version": "0.7.2",
  "description": "Provider-neutral deployment, provisioning, and validation primitives for LVBT web repositories.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
