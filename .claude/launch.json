{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "transitmapper",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@transitmapper/web", "dev"],
      "port": 5173
    },
    {
      "name": "transitmapper-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@transitmapper/worker", "dev", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "transitmapper-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@transitmapper/web",
        "run",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
