{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "CI",
    "DEV",
    "PROD",
    "PORT",
    "DEBT_BASE_REF",
    "MIGRATION_BASE_REF",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_API_TOKEN",
    "GTFS_FEED_SLUG"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@transitmapper/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".perf-harness-dist/**", "*.tsbuildinfo"],
      "env": [
        "GITHUB_SHA",
        "TRANSITMAPPER_BUILD_COMMIT",
        "TRANSITMAPPER_BUILD_DIRTY",
        "TRANSITMAPPER_RELEASE_TAG",
        "TRANSITMAPPER_PERFORMANCE_SAMPLING_ENABLED",
        "TRANSITMAPPER_PERFORMANCE_ORDINARY_BASIS_POINTS",
        "TRANSITMAPPER_PERFORMANCE_RELEASE_BASIS_POINTS",
        "VITE_PERF_BUILD",
        "VITE_SITE_URL"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/node_modules/@lvbt/typescript-config/*.json"],
      "outputs": ["*.tsbuildinfo"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/packages/eslint-plugin/src/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/node_modules/@lvbt/typescript-config/*.json"],
      "outputs": []
    },
    "check:types": {
      "inputs": ["scripts/check-generated-types.ts", "wrangler.toml", "worker-configuration.d.ts"],
      "outputs": []
    },
    "check:icons": {
      "inputs": [
        "scripts/**",
        "src/assets/**",
        "src/map/lucideIconNodes.ts",
        "public/**",
        "$TURBO_ROOT$/packages/core/src/style/lvbtBrand.ts"
      ],
      "outputs": []
    },
    "lint:workspace": {
      "dependsOn": ["lint", "//#lint:root"],
      "outputs": []
    },
    "validate": {
      "dependsOn": [
        "lint",
        "check-types",
        "test",
        "check:types",
        "check:icons",
        "//#format:check",
        "//#lint:root",
        "//#typecheck:root",
        "//#verify:root",
        "//#check:filenames",
        "//#check:contract",
        "//#check:docs",
        "//#check:migrations",
        "//#check:structure",
        "//#check:breakpoint",
        "//#check:config",
        "//#check:debt",
        "//#check:deadcode",
        "//#check:duplication",
        "//#check:boundaries",
        "//#check:documents",
        "//#check:reference"
      ],
      "outputs": []
    },
    "//#format:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#lint:root": {
      "inputs": [
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/packages/eslint-plugin/src/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/turbo/**"
      ],
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": [
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/turbo/**",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/package.json"
      ],
      "outputs": []
    },
    "//#check:filenames": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#check:contract": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#check:docs": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#check:migrations": {
      "cache": false,
      "inputs": [
        "$TURBO_ROOT$/apps/worker/src/migrations/**",
        "$TURBO_ROOT$/scripts/check-migrations-append-only.ts"
      ],
      "outputs": []
    },
    "//#check:structure": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#check:breakpoint": {
      "inputs": [
        "scripts/check-breakpoint.ts",
        "apps/web/src/ui/app.css",
        "packages/workspace/src/media-query.ts",
        "packages/workspace/src/workbench.css"
      ],
      "outputs": []
    },
    "//#check:config": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#check:debt": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#check:deadcode": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#check:duplication": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#check:boundaries": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#check:documents": {
      "inputs": [
        "$TURBO_ROOT$/*.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/scripts/check-document-standards.ts"
      ],
      "outputs": []
    },
    "//#check:reference": {
      "inputs": [
        "$TURBO_ROOT$/prettier.config.mjs",
        "$TURBO_ROOT$/docs/development/reference/checks.md",
        "$TURBO_ROOT$/scripts/generate-checks-reference.ts"
      ],
      "outputs": []
    },
    "//#verify:root": {
      "cache": false,
      "outputs": []
    }
  }
}
