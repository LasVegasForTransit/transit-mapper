{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["CI", "DEV", "PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "*.tsbuildinfo"],
      "env": [
        "GITHUB_SHA",
        "TRANSITMAPPER_BUILD_COMMIT",
        "TRANSITMAPPER_BUILD_DIRTY",
        "TRANSITMAPPER_RELEASE_TAG",
        "VITE_PERF_BUILD"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "validate": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "//#validate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "scripts/**",
        "turbo/**",
        "docs/**",
        "apps/worker/src/migrations/**"
      ],
      "cache": false,
      "env": ["MIGRATION_BASE_REF"]
    },
    "@transitmapper/web#validate": {
      "inputs": [
        "scripts/**",
        "src/assets/**",
        "src/map/lucideIconNodes.ts",
        "public/**",
        "$TURBO_ROOT$/packages/core/src/style/lvbtBrand.ts"
      ]
    },
    "@transitmapper/worker#validate": {
      "inputs": ["scripts/check-generated-types.ts", "wrangler.toml", "worker-configuration.d.ts"]
    }
  }
}
